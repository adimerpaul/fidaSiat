<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="xyz.cesarnvf.aigfec.repositorio.EnlacesrolesRepositorio">

    <select id="obtenerPorIdenlace" resultType="EnlacesRoles">
        select idrol
        from seguridad.enlacesroles
        where idenlace=#{id}
    </select>

</mapper>